<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>KitchenCrew</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>KitchenCrew uses the microphone for hands-free kitchen voice conductor navigation.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>KitchenCrew uses speech recognition to parse hands-free kitchen intents like 'next step' and timers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>KitchenCrew uses local network to synchronize recipe steps and timers with household iPhones and iPads.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_kitchen-crew._tcp</string>
		<string>_kitchen-crew._udp</string>
	</array>
</dict>
</plist>
